APP_NAME="The Gats Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thegats_booking
DB_USERNAME=thegats
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="datban@thegats.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Kenh gui thong bao cho khach ---
# email | sms | zalo  (ngan cach bang dau phay). Khong cau hinh -> chi ghi log
BOOKING_NOTIFY_CHANNELS=email

# Zalo OA (de trong = tat, chi ghi log)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_TEMPLATE_CONFIRMED=
ZALO_OA_ENDPOINT=https://business.openapi.zalo.me/message/template

# SMS brandname (vi du eSMS.vn) - de trong = tat, chi ghi log
SMS_DRIVER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME="THEGATS"
SMS_ENDPOINT=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/

# Ten mien khu quan ly - nhin duoc ca chuoi
ADMIN_DOMAIN=
